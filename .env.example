# Site → companion. Server-side only; the browser never receives these.
AFTERIMAGE_BRIDGE_URL=http://localhost:8788
AFTERIMAGE_BRIDGE_SECRET=replace-with-the-same-long-secret-used-by-the-companion
SITE_ORIGIN=https://your-private-afterimage-site.example

# Read by `npm run companion` (the Claude companion) during local development.
# Your Claude subscription: create the token with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=replace-with-the-token-from-claude-setup-token
# Or an Anthropic API key instead, with AFTERIMAGE_CLAUDE_AUTH=api.
# ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
AFTERIMAGE_FILM_METADATA_URL=http://localhost:3000/api/films/enrich
TMDB_READ_TOKEN=replace-with-your-tmdb-read-access-token

# GitHub Pages version (see docs/github-pages.md): the companion opens its
# browser routes with this passphrase. `npm run dev:pages` reaches the companion
# at http://localhost:8788; `npm run build:pages` takes its address from the
# shell, as AFTERIMAGE_COMPANION_URL.
# AFTERIMAGE_SITE_PASSPHRASE=replace-with-a-long-passphrase-of-your-own
