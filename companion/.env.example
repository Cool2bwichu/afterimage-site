# How the companion reaches Claude. Never commit a real token or key.
# subscription: your Claude Pro/Max plan through Claude Code. Create the token on
# your own computer with `claude setup-token` (valid for one year).
AFTERIMAGE_CLAUDE_AUTH=subscription
CLAUDE_CODE_OAUTH_TOKEN=replace-with-the-token-from-claude-setup-token
# api: an Anthropic API key instead (billed per token). Set AFTERIMAGE_CLAUDE_AUTH=api.
# ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key

# GitHub Pages site (see ../docs/github-pages.md): the browser calls the
# companion directly, unlocked with this passphrase (16+ characters).
AFTERIMAGE_SITE_PASSPHRASE=replace-with-a-long-passphrase-of-your-own
AFTERIMAGE_ALLOWED_ORIGINS=https://cool2bwichu.github.io
# TMDB read access token: film search and details for the Pages site, and
# verification of Atlas and replacement films.
TMDB_READ_TOKEN=replace-with-your-tmdb-read-access-token

# Or a site with its own server routes: the same long secret the site uses to
# reach the companion, and the site's film enrichment endpoint.
# AFTERIMAGE_BRIDGE_SECRET=replace-with-at-least-32-random-characters
# AFTERIMAGE_FILM_METADATA_URL=https://your-private-afterimage-site.example/api/films/enrich
# Persistent job storage; required in production.
AFTERIMAGE_JOB_DIR=/data/afterimage-generation-jobs
PORT=8788
# Optional. Defaults: claude-opus-5-5 at high effort. In api mode, server-side
# refusal fallbacks are on unless AFTERIMAGE_CLAUDE_FALLBACKS=off.
# AFTERIMAGE_CLAUDE_MODEL=claude-opus-5-5
# AFTERIMAGE_CLAUDE_EFFORT=high
# CLAUDE_BIN=claude
